{
  "name": "@dynastxu/dsh-multiple-roots-workspace",
  "version": "0.1.0",
  "description": "Attach extra folders, or another workspace's folders, to a DeepSeek Harness workspace with per-folder read-only control.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "multi-root",
    "sandbox",
    "workspace",
    "writable-root"
  ],
  "license": "MIT",
  "author": "Dynastxu <151742029+dynastxu@users.noreply.github.com>",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.client.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.81.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.2",
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.28.5",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dynastxu/dsh-multiple-roots-workspace.git"
  },
  "homepage": "https://github.com/Dynastxu/dsh-multiple-roots-workspace",
  "bugs": "https://github.com/Dynastxu/dsh-multiple-roots-workspace/issues"
}
